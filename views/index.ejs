<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Servidor Web</title>
</head>

<body>
    <ul>
        <h1>Tabuada do 7</h1>
        <% for(let i=0;i<10; i++){ %>
            <li>
                <%= (i+1) %> x 7= <%= ((i+1) * 7) %>
            </li>
            <% } %>
    </ul>
</body>
